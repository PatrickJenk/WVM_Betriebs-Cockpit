# Vorlage kopieren nach .env.production und Werte beim späteren Hosting festlegen.
NODE_ENV=production
COCKPIT_MFA_ENABLED=0
HOST=0.0.0.0
# PORT wird bei Infomaniak vom Manager gesetzt; keinen fremden festen Port erzwingen.
COCKPIT_ORIGIN=https://cockpit.example.ch
COCKPIT_DATA_DIR=/absoluter/dauerhafter/pfad/cockpit-data
# Nur aktivieren, wenn der Node-Port ausschliesslich durch den vertrauenswürdigen
# HTTPS-Proxy erreichbar ist und dieser X-Forwarded-Proto zuverlässig setzt.
COCKPIT_TRUST_PROXY=1
COCKPIT_MAX_FILE_MB=60
COCKPIT_USER_QUOTA_MB=10240
COCKPIT_TOTAL_QUOTA_MB=102400
# Für Uploads im Produktionsmodus ist ein erreichbarer privater ClamAV-Dienst nötig.
COCKPIT_CLAMAV_HOST=127.0.0.1
COCKPIT_CLAMAV_PORT=3310
